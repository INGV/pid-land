{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/INGV/wf-search/schema/json/wf-search-input.schema.json",
  "title": "WF Search Input",
  "type": "object",
  "required": ["@type", "spatial", "temporal"],
  "properties": {
    "@type": {
      "type": "string",
      "const": "WFSearchRequest"
    },
    "spatial": {
      "type": "object",
      "required": ["lat", "lon", "rad"],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "rad": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "temporal": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
