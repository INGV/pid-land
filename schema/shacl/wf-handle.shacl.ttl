@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix wf: <https://w3id.org/ingv/workflow#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .

########################################
# Class
########################################

wf:WFHandle a rdfs:Class ;
    rdfs:label "WaveForm Handle" ;
    rdfs:comment "Metadata description of a waveform digital object" .

########################################
# Main NodeShape
########################################

wf:WFHandleShape
    a sh:NodeShape ;
    sh:targetClass wf:WFHandle ;

    ## --- PID identity ---
    sh:property [
        sh:path dc:identifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^\\d+/.+" ;
        sh:message "dc:identifier must be a PID (prefix/suffix)" ;
    ] ;

    ## --- Descriptive metadata ---
    sh:property [
        sh:path dc:title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path dc:creator ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path dc:publisher ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path dc:format ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path dc:rights ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    ## --- Temporal coverage ---
    sh:property [
        sh:path dcterms:temporal ;
        sh:node wf:TemporalCoverageShape ;
        sh:minCount 1 ;
    ] ;

    ## --- Spatial coverage ---
    sh:property [
        sh:path dcterms:spatial ;
        sh:node wf:SpatialCoverageShape ;
        sh:minCount 1 ;
    ] ;

    ## --- File entity ---
    sh:property [
        sh:path schema:file ;
        sh:node wf:FileShape ;
        sh:minCount 1 ;
    ] .

########################################
# Temporal coverage
########################################

wf:TemporalCoverageShape
    a sh:NodeShape ;

    sh:property [
        sh:path dcterms:start ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dcterms:end ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    ## Logical constraint: start <= end
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "dcterms:start must be earlier than or equal to dcterms:end" ;
        sh:select """
            SELECT $this
            WHERE {
                $this dcterms:start ?start ;
                      dcterms:end ?end .
                FILTER (?start > ?end)
            }
        """ ;
    ] .

########################################
# Spatial coverage
########################################

wf:SpatialCoverageShape
    a sh:NodeShape ;

    sh:property [
        sh:path schema:latitude ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
    ] ;

    sh:property [
        sh:path schema:longitude ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
    ] ;

    sh:property [
        sh:path schema:altitude ;
        sh:datatype xsd:double ;
        sh:minCount 0 ;
    ] .

########################################
# File description
########################################

wf:FileShape
    a sh:NodeShape ;

    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path schema:url ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
    ] .
