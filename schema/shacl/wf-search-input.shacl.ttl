@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wf: <https://w3id.org/ingv/workflow#> .

wf:WFSearchRequestShape
    a sh:NodeShape ;
    sh:targetClass wf:WFSearchRequest ;

    sh:property [
        sh:path wf:start ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path wf:end ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "start date must be earlier than or equal to end date" ;
        sh:select """
            SELECT $this
            WHERE {
              $this wf:start ?s ;
                    wf:end ?e .
              FILTER (?s > ?e)
            }
        """
    ] .
