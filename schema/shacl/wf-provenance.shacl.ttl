@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix wf: <https://w3id.org/ingv/workflow#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <http://schema.org/> .

########################################
# Class
########################################

wf:WFProvenance a rdfs:Class ;
    rdfs:label "Waveform Provenance" ;
    rdfs:comment "Provenance description for waveform workflow objects" .

########################################
# Main NodeShape
########################################

wf:WFProvenanceShape
    a sh:NodeShape ;
    sh:targetClass wf:WFProvenance ;

    sh:property [
        sh:path dc:identifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dcterms:isPartOf ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path prov:generatedAtTime ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path prov:wasAttributedTo ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path prov:usage ;
        sh:node wf:UsageShape ;
    ] ;

    sh:property [
        sh:path prov:wasRevisionOf ;
        sh:node wf:RevisionShape ;
        sh:minCount 1 ;
    ] .

########################################
# Usage
########################################

wf:UsageShape a sh:NodeShape ;
    sh:property [
        sh:path schema:SoftwareApplication ;
        sh:datatype xsd:anyURI ;
    ] .

########################################
# Revision
########################################

wf:RevisionShape a sh:NodeShape ;

    sh:property [
        sh:path dc:hasVersion ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path schema:startDate ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path schema:Organization ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path prov:SoftwareAgent ;
        sh:datatype xsd:anyURI ;
    ] ;

    sh:property [
        sh:path dcterms:spatial ;
        sh:node wf:SpatialShape ;
    ] ;

    sh:property [
        sh:path schema:file ;
        sh:node wf:FileShape ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:node wf:GenerationShape ;
        sh:minCount 1 ;
    ] .

########################################
# Spatial
########################################

wf:SpatialShape a sh:NodeShape ;
    sh:property [ sh:path schema:x ; sh:datatype xsd:double ; sh:minCount 1 ] ;
    sh:property [ sh:path schema:y ; sh:datatype xsd:double ; sh:minCount 1 ] ;
    sh:property [ sh:path schema:z ; sh:datatype xsd:double ; sh:minCount 1 ] .

########################################
# File
########################################

wf:FileShape a sh:NodeShape ;
    sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path schema:position ; sh:datatype xsd:anyURI ; sh:minCount 1 ] .

########################################
# Generation
########################################

wf:GenerationShape a sh:NodeShape ;
    sh:property [ sh:path prov:hadPrimarySource ; sh:datatype xsd:anyURI ; sh:minCount 1 ] ;
    sh:property [ sh:path schema:SoftwareApplication ; sh:datatype xsd:anyURI ] ;
    sh:property [ sh:path schema:Organization ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dcterms:accrualPeriodicity ; sh:datatype xsd:string ] .
